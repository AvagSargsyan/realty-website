# Copy to .env.local and fill in. Never commit real values.

# Postgres. Local: the docker-compose database. Vercel: the Neon pooled connection string (main branch for Production, develop branch for Preview).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/realty_website

# Long random string, different per environment (e.g. `openssl rand -hex 32`)
PAYLOAD_SECRET=

# Vercel Blob. When empty, uploads are stored on disk in /media (local development only).
BLOB_READ_WRITE_TOKEN=

# Lead emails through Resend (resend.com). When either is empty, no emails are sent.
# Without an own domain Resend sends only from onboarding@resend.dev to the Resend account's own email.
RESEND_API_KEY=
LEAD_EMAIL_TO=
# Optional, default "Avenue website <onboarding@resend.dev>"
LEAD_EMAIL_FROM=

# Cloudflare Turnstile bot check on the forms. When empty, the check is off.
# Test keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
