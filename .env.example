# Copy to .env.local and fill in. Never commit real values.

# Postgres. Local: the docker-compose database. Vercel: set by the Neon integration.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/realty_website

# Long random string, different per environment (e.g. `openssl rand -hex 32`)
PAYLOAD_SECRET=

# Public URL of this deployment (no trailing slash). Local: http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob. When empty, uploads are stored on disk in /media (local development only).
BLOB_READ_WRITE_TOKEN=
